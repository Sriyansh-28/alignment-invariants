# Copy to .env and fill in. .env is gitignored and must NEVER be committed.
#
# Obtain a free-tier key from Google AI Studio: https://aistudio.google.com/apikey

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Hard ceiling on live API calls for the whole run. The runner refuses to
# exceed this regardless of what the config file requests. Cache hits do not
# count against it.
MAX_API_CALLS=250
